<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts bada at login, so the key tap runs before bada is first selected. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.teammirae.inputmethod.Bada.login</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-b</string>
        <string>com.teammirae.inputmethod.Bada</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
