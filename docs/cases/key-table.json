    {"name": "a key of a bound pair, pressed alone, runs its own binding when released", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "up:Lang1"], "expect": [{"at": 1, "then": "select", "binding": 2, "ran": "profile:main", "mode": "henkan", "profile": "main"}]},
    {"name": "…or as soon as another key is pressed, before that key", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "down:KeyA", "up:Lang1", "up:KeyA"], "expect": [{"at": 1, "then": "select", "binding": 2, "ran": "profile:main", "mode": "henkan", "profile": "main"}, {"at": 1, "then": "key", "binding": null, "ran": null}]},
    {"name": "another key while both are down: no pair, and neither key's own binding", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "down:KanaMode", "down:KeyA", "up:KeyA", "up:KanaMode", "up:Lang1"], "expect": [{"at": 2, "then": "key", "binding": null, "ran": null}]},
    {"name": "one after the other is not a pair", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "up:Lang1", "down:KanaMode", "up:KanaMode"], "expect": [{"at": 1, "then": "select", "binding": 2, "ran": "profile:main", "mode": "henkan", "profile": "main"}, {"at": 3, "then": "select", "binding": 6, "ran": "profile:ja", "mode": "henkan", "profile": "ja"}]},
    {"name": "two keys of bound pairs that aren't a pair together: each its own", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "down:Convert", "up:Lang1", "up:Convert"], "expect": [{"at": 1, "then": "select", "binding": 2, "ran": "profile:main", "mode": "henkan", "profile": "main"}, {"at": 3, "then": "select", "binding": 5, "ran": "profile:work", "mode": "henkan", "profile": "work"}]},
    {"name": "with no pair bound, a language key runs when it is pressed", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "up:Lang1"], "expect": [{"at": 0, "then": "select", "binding": 1, "ran": "profile.first", "mode": "henkan", "profile": "main"}]},
    {"name": "a key waits only for a pair binding that holds when it is pressed", "table": "odd", "profiles": "four", "state": {"mode": "muhenkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "up:Lang1"], "expect": [{"at": 0, "then": "select", "binding": 1, "ran": "mode.toggle", "mode": "henkan", "profile": "work"}]},
    {"name": "…and where it holds, the key waits", "table": "odd", "profiles": "four", "state": {"mode": "henkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "up:Lang1"], "expect": [{"at": 1, "then": "select", "binding": 1, "ran": "mode.toggle", "mode": "muhenkan", "profile": "main"}]},
    {"name": "…so two of them together are just one and then the other", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "down:KanaMode", "up:Lang1", "up:KanaMode"], "expect": [{"at": 0, "then": "select", "binding": 1, "ran": "profile.first", "mode": "henkan", "profile": "main"}, {"at": 1, "then": "pass", "binding": null, "ran": null}]}
