    {"name": "変換 in another profile with one row has nothing to step through: back to the first", "table": "jis-pc", "profiles": "four", "state": {"mode": "henkan", "profile": "work", "menu_rows": 1, "staged": "a", "caps_lock": false}, "press": "Convert", "expect": {"then": "select", "binding": 2, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "変換 in another profile with no menu goes back to the first", "table": "jis-pc", "profiles": "four", "state": {"mode": "henkan", "profile": "ja", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Convert", "expect": {"then": "select", "binding": 2, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "変換 in the first profile with one row does nothing", "table": "jis-pc", "profiles": "four", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "한", "caps_lock": false}, "press": "Convert", "expect": {"then": "swallow", "binding": 2, "ran": null}},
