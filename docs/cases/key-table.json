    {"name": "Caps Lock unbound and respect: the lock in henkan too", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "CapsLock", "expect": {"then": "pass", "binding": null, "ran": null, "caps_lock": true}},
