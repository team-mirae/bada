{
  "format": "bada-key-cases/1",
  "note": "Each harness's own tests replay these (the standard, §9.6). binding is an index into the table's bindings.",
  "profiles": {
    "none": [],
    "one": [{"id": "main", "layouts": ["ja-romaji"]}],
    "four": [{"id": "main", "layouts": ["ko-2-set"]}, {"id": "work", "layouts": ["en-qwerty", "ko-2-set", "ja-romaji"]}, {"id": "ja", "layouts": ["ja-kana"]}, {"id": "sym", "layouts": ["uni-symbols", "uni-emojis"]}]
  },
  "tables": {
    "jis-mac": {
      "bindings": [
        {"on": "Lang2", "do": ["mode:muhenkan"]},
        {"on": "Lang1", "do": ["profile.first"]},
        {"on": "Lang1", "do": ["menu.next", "profile.first"], "when": "henkan"},
        {"on": "shift+Lang1", "do": ["menu.prev"], "when": "henkan"},
        {"on": "ctrl+Lang1", "do": ["fix"], "when": "henkan"},
        {"on": "Backquote", "do": ["width.full"]},
        {"on": "shift+Backquote", "do": ["width.half"]}
      ],
      "cycle": [], "henkan_enters": "last", "caps_lock": "respect", "caps_rule": "allcaps"
    },
    "jis-pc": {
      "bindings": [
        {"on": "NonConvert", "do": ["mode:muhenkan"]},
        {"on": "Convert", "do": ["profile.first"]},
        {"on": "Convert", "do": ["menu.next", "profile.first"], "when": "henkan"},
        {"on": "shift+Convert", "do": ["menu.prev"], "when": "henkan"},
        {"on": "ctrl+Convert", "do": ["fix"], "when": "henkan"},
        {"on": "Backquote", "do": ["width.full"]},
        {"on": "shift+Backquote", "do": ["width.half"]}
      ],
      "cycle": [], "henkan_enters": "last", "caps_lock": "respect", "caps_rule": "allcaps"
    },
    "no-language-keys": {
      "bindings": [
        {"on": "CapsLock", "do": ["mode.toggle"]}
      ],
      "cycle": [], "henkan_enters": "last", "caps_lock": "respect", "caps_rule": "allcaps"
    },
    "example": {
      "bindings": [
        {"on": "CapsLock", "do": ["mode.toggle"]},
        {"on": "Lang2", "do": ["mode:muhenkan"]},
        {"on": "Lang1", "do": ["profile:main"]},
        {"on": "shift+Lang1", "do": ["menu.prev"], "when": "henkan"},
        {"on": "ctrl+Lang1", "do": ["fix"], "when": "henkan"},
        {"on": "Convert", "do": ["profile:work", "menu.next"]},
        {"on": "KanaMode", "do": ["profile:ja", "menu.next"]},
        {"on": "Lang1", "do": ["menu.next", "profile:main"], "when": "henkan"},
        {"on": "ctrl+alt+shift+meta+Space", "do": ["profile.next"]},
        {"on": "Backquote", "do": ["width.full"]},
        {"on": "shift+Backquote", "do": ["width.half"]},
        {"on": "KanaMode+Lang1", "do": ["profile:sym"]},
        {"on": "Convert+KanaMode", "do": ["profile.last"]},
        {"on": "F13", "do": ["ja-kana.katakana", "pass"]},
        {"on": "alt+Lang2", "do": ["none"]},
        {"on": "Lang2", "do": ["mode:muhenkan", "pass"], "when": "muhenkan"},
        {"on": "ctrl+alt+shift+Space", "do": ["profile.prev"]},
        {"on": "ctrl+Lang1", "do": ["ja-kana.katakana"], "when": "profile:ja"}
      ],
      "cycle": ["main", "work", "ja"], "henkan_enters": "last", "caps_lock": "transient", "caps_rule": "upper_snake"
    },
    "example-pc": {
      "bindings": [
        {"on": "NonConvert", "do": ["mode:muhenkan"]},
        {"on": "Convert", "do": ["profile:main"]},
        {"on": "Convert", "do": ["menu.next", "profile:main"], "when": "henkan"},
        {"on": "shift+Convert", "do": ["menu.prev"], "when": "henkan"},
        {"on": "KanaMode", "do": ["profile:ja", "menu.next"]}
      ],
      "cycle": [], "henkan_enters": "last", "caps_lock": "respect", "caps_rule": "allcaps"
    },
    "toggle-key": {
      "bindings": [
        {"on": "NonConvert", "do": ["mode:muhenkan"]},
        {"on": "Convert", "do": ["profile.first"]},
        {"on": "shift+Tab", "do": ["menu.prev", "mode.toggle"]}
      ],
      "cycle": [], "henkan_enters": "last", "caps_lock": "respect", "caps_rule": "allcaps"
    },
    "odd": {
      "bindings": [
        {"on": "Lang1", "do": ["mode:henkan"]},
        {"on": "Lang1", "do": ["mode.toggle"]},
        {"on": "Convert", "do": ["profile:gone", "menu.next"]},
        {"on": "KanaMode", "do": ["mode:henkan"]},
        {"on": "F13", "do": ["profile.next", "pass"]},
        {"on": "Lang1+Lang2", "do": ["none"], "when": "henkan"}
      ],
      "cycle": ["gone"], "henkan_enters": "work", "caps_lock": "respect", "caps_rule": "allcaps"
    }
  },
  "cases": [
    {"name": "かな with no profile opens the onboarding", "table": "jis-mac", "profiles": "none", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang1", "expect": {"then": "onboarding", "binding": 1, "ran": "profile.first"}},
    {"name": "かな in muhenkan enters the first profile", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang1", "expect": {"then": "select", "binding": 1, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "かな in muhenkan enters the first profile, whichever was last used", "table": "jis-mac", "profiles": "four", "state": {"mode": "muhenkan", "profile": "work", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang1", "expect": {"then": "select", "binding": 1, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "かな in the first profile is the next entry", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 3, "staged": "かんじ", "caps_lock": false}, "press": "Lang1", "expect": {"then": "action", "binding": 2, "ran": "menu.next", "name": "menu.next"}},
    {"name": "かな in the first profile with one row does nothing", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "한", "caps_lock": false}, "press": "Lang1", "expect": {"then": "swallow", "binding": 2, "ran": null}},
    {"name": "かな in the first profile with nothing staged does nothing", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang1", "expect": {"then": "swallow", "binding": 2, "ran": null}},
    {"name": "かな in another profile with a menu is the next entry", "table": "jis-mac", "profiles": "four", "state": {"mode": "henkan", "profile": "work", "menu_rows": 2, "staged": "inter", "caps_lock": false}, "press": "Lang1", "expect": {"then": "action", "binding": 2, "ran": "menu.next", "name": "menu.next"}},
    {"name": "かな in another profile with one row has nothing to step through: back to the first", "table": "jis-mac", "profiles": "four", "state": {"mode": "henkan", "profile": "work", "menu_rows": 1, "staged": "a", "caps_lock": false}, "press": "Lang1", "expect": {"then": "select", "binding": 2, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "かな in another profile with no menu goes back to the first", "table": "jis-mac", "profiles": "four", "state": {"mode": "henkan", "profile": "work", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang1", "expect": {"then": "select", "binding": 2, "ran": "profile.first", "mode": "henkan", "profile": "main"}},
    {"name": "⇧かな is the previous entry", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 2, "staged": "かんじ", "caps_lock": false}, "press": "shift+Lang1", "expect": {"then": "action", "binding": 3, "ran": "menu.prev", "name": "menu.prev"}},
    {"name": "⇧かな in another profile is the previous entry too", "table": "jis-mac", "profiles": "four", "state": {"mode": "henkan", "profile": "ja", "menu_rows": 3, "staged": "かんじ", "caps_lock": false}, "press": "shift+Lang1", "expect": {"then": "action", "binding": 3, "ran": "menu.prev", "name": "menu.prev"}},
    {"name": "⇧かな with one row does nothing", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "한", "caps_lock": false}, "press": "shift+Lang1", "expect": {"then": "swallow", "binding": 3, "ran": null}},
    {"name": "⇧かな in muhenkan has no binding and goes to the OS", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "shift+Lang1", "expect": {"then": "pass", "binding": null, "ran": null}},
    {"name": "⌃かな fixes what shows", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 2, "staged": "あなた", "caps_lock": false}, "press": "ctrl+Lang1", "expect": {"then": "action", "binding": 4, "ran": "fix", "name": "fix"}},
    {"name": "⌃かな with nothing staged does nothing", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "ctrl+Lang1", "expect": {"then": "swallow", "binding": 4, "ran": null}},
    {"name": "英数 leaves henkan", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 2, "staged": "한", "caps_lock": false}, "press": "Lang2", "expect": {"then": "select", "binding": 0, "ran": "mode:muhenkan", "mode": "muhenkan", "profile": "main"}},
    {"name": "英数 in muhenkan does nothing", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Lang2", "expect": {"then": "swallow", "binding": 0, "ran": null}},
    {"name": "半角/全角 makes full-width", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "abc", "caps_lock": false}, "press": "Backquote", "expect": {"then": "action", "binding": 5, "ran": "width.full", "name": "width.full"}},
    {"name": "半角/全角 makes full-width in muhenkan too", "table": "jis-mac", "profiles": "one", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "Backquote", "expect": {"then": "action", "binding": 5, "ran": "width.full", "name": "width.full"}},
    {"name": "⇧半角/全角 makes half-width", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "ａｂｃ", "caps_lock": false}, "press": "shift+Backquote", "expect": {"then": "action", "binding": 6, "ran": "width.half", "name": "width.half"}},
    {"name": "a letter isn't the table's: it is fed to the engine", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "KeyA", "expect": {"then": "key", "binding": null, "ran": null}},
    {"name": "a shortcut isn't the table's either", "table": "jis-mac", "profiles": "one", "state": {"mode": "henkan", "profile": "main", "menu_rows": 1, "staged": "한", "caps_lock": false}, "press": "meta+KeyC", "expect": {"then": "key", "binding": null, "ran": null}},
