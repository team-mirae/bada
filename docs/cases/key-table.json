  "sequences": [
    {"name": "a pair runs when both keys are up", "table": "example", "profiles": "four", "state": {"mode": "muhenkan", "profile": null, "menu_rows": 0, "staged": "", "caps_lock": false}, "keys": ["down:Lang1", "down:KanaMode", "up:Lang1", "up:KanaMode"], "expect": [{"at": 3, "then": "select", "binding": 11, "ran": "profile:sym", "mode": "henkan", "profile": "sym"}]},
