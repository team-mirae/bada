    {"name": "a profile's own key is the next entry there", "table": "example", "profiles": "four", "state": {"mode": "henkan", "profile": "work", "menu_rows": 2, "staged": "inter", "caps_lock": false}, "press": "Convert", "expect": {"then": "action", "binding": 5, "ran": "menu.next", "name": "menu.next"}},
