    {"name": "Caps Lock toggles into the profile last used", "table": "no-language-keys", "profiles": "four", "state": {"mode": "muhenkan", "profile": "work", "menu_rows": 0, "staged": "", "caps_lock": false}, "press": "CapsLock", "expect": {"then": "select", "binding": 0, "ran": "mode.toggle", "mode": "henkan", "profile": "work"}},
